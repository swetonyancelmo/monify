# Copie para .env e preencha. Para carregar no terminal: set -a && . ./.env && set +a

# Obrigatório. Gere com: openssl rand -base64 32
JWT_SECRET=

# Opcionais (os valores abaixo batem com o docker-compose.yml de desenvolvimento)
DB_URL=jdbc:postgresql://localhost:5433/monify_db
DB_USERNAME=postgres
DB_PASSWORD=admin
